	partition gold_outcomes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportsFolder & "\gold_outcomes.csv"),[Delimiter=",", Columns=5, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
