table gold_signals
	lineageTag: 86d2be9a-ad41-464c-b527-e7782ba09385

	measure 'Total Pairs' = ```
			COUNTROWS ( gold_signals ) 
			```
		formatString: 0
		lineageTag: 70a5c84f-74f5-4667-89f4-3beb1e806db8

		changedProperty = IsHidden

	measure 'Signal Pairs' =
			
			CALCULATE ( COUNTROWS ( gold_signals ), gold_signals[signal_flag] = "SIGNAL" )
		formatString: #,0
		lineageTag: 5ab7f5cf-d24f-4ad5-8c00-0e40bbdf6c41

		changedProperty = IsHidden

	measure 'Exclusive Signal Pairs' =
			
			CALCULATE (
			    COUNTROWS ( gold_signals ),
			    gold_signals[signal_flag] = "SIGNAL",
			    gold_signals[is_exclusive] = TRUE ()
			)
		formatString: 0
		lineageTag: 2c721663-d758-4119-b828-6e150ccf823c

	measure 'Leaderboard Pairs' =
			
			CALCULATE (
			    COUNTROWS ( gold_signals ),
			    gold_signals[signal_flag] = "SIGNAL",
			    gold_signals[is_exclusive] = FALSE ()
			)
		formatString: 0
		lineageTag: 3a36ec89-5522-472c-a0fc-302b72b8369c

	measure 'Haldane Pairs' = ```
			
			CALCULATE ( COUNTROWS ( gold_signals ), gold_signals[haldane_applied] = TRUE () )
			
			```
		formatString: 0
		lineageTag: 8520f652-6ddd-4a2a-b648-3ffc8b1be0f4

	measure 'Haldane %' = DIVIDE ( [Haldane Pairs], [Total Pairs] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bf8bd699-d0b6-43aa-9ca9-f0b99da7f9ec

	measure Cases = MAX ( gold_signals[total_reports] )
		formatString: 0
		lineageTag: 5dcc6c7e-b114-4416-bfff-cb691c43a59a

		changedProperty = IsHidden

	measure Rank =
			
			RANKX (
			    ALLSELECTED ( gold_signals ),
			    CALCULATE ( MAX ( gold_signals[case_count] ) ) * 1000000
			        + CALCULATE ( MAX ( gold_signals[prr] ) ),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: ea517cd1-b4f5-41be-8d41-db98474d34e3

